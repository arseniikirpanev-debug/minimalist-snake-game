<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Snake Mini</title>
    <style>
        body { background: #121214; color: #fff; font-family: sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
        .score { font-size: 1.2rem; margin-bottom: 15px; }
        canvas { background: #1c1c1e; border: 2px solid #29292e; border-radius: 8px; }
        .btn { background: #04d361; border: none; padding: 10px 20px; font-weight: bold; border-radius: 6px; cursor: pointer; margin-top: 15px; }
    </style>
</head>
<body>
    <div class="score">Score: <span id="s">0</span> | High: <span id="h">0</span></div>
    <canvas id="c" width="400" height="400"></canvas>
    <button class="btn" id="b">Старт</button>

    <script>
        const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('s'), highEl = document.getElementById('h'), btn = document.getElementById('b');
        const size = 20, count = 20;
        let snake = [], food = {x:0, y:0}, dx = size, dy = 0, score = 0, hScore = localStorage.getItem('h') || 0, iv;

        highEl.innerText = hScore;

        function loop() {
            const head = {x: snake[0].x + dx, y: snake[0].y + dy};
            if (head.x<0 || head.x>=400 || head.y<0 || head.y>=400 || snake.some(p => p.x===head.x && p.y===head.y)) return end();
            
            snake.unshift(head);
            if (head.x === food.x && head.y === food.y) {
                score += 10; scoreEl.innerText = score; genFood();
            } else snake.pop();

            ctx.fillStyle = '#1c1c1e'; ctx.fillRect(0, 0, 400, 400);
            ctx.fillStyle = '#ff5555'; ctx.fillRect(food.x+2, food.y+2, size-4, size-4);
            ctx.fillStyle = '#04d361'; snake.forEach(p => ctx.fillRect(p.x+1, p.y+1, size-2, size-2));
        }

        function genFood() {
            food.x = Math.floor(Math.random() * count) * size;
            food.y = Math.floor(Math.random() * count) * size;
            if (snake.some(p => p.x === food.x && p.y === food.y)) genFood();
        }

        function end() {
            clearInterval(iv); btn.style.display = 'block';
            if (score > hScore) { hScore = score; localStorage.setItem('h', hScore); highEl.innerText = hScore; }
        }

        btn.onclick = () => {
            snake = [{x:160, y:200}, {x:140, y:200}, {x:120, y:200}];
            score = 0; scoreEl.innerText = 0; dx = size; dy = 0;
            btn.style.display = 'none'; genFood(); clearInterval(iv); iv = setInterval(loop, 100);
        };

        document.onkeydown = e => {
            if ((e.key==='ArrowLeft' || e.key==='a') && dx===0) { dx=-size; dy=0; }
            if ((e.key==='ArrowUp' || e.key==='w') && dy===0) { dx=0; dy=-size; }
            if ((e.key==='ArrowRight' || e.key==='d') && dx===0) { dx=size; dy=0; }
            if ((e.key==='ArrowDown' || e.key==='s') && dy===0) { dx=0; dy=size; }
        };
    </script>
</body>
</html>
